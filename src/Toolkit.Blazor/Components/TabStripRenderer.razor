@namespace Xarial.XCad.Toolkit.Blazor.Components

@{
    var visibleTabs = Tabs.Where(t => t.Visible).ToList();
}
@if (visibleTabs.Any())
{
    BlazorPropertyManagerPageTab activeTab;

    if (m_ActiveTab != null && visibleTabs.Contains(m_ActiveTab))
    {
        activeTab = m_ActiveTab;
    }
    else
    {
        activeTab = visibleTabs.First();
    }

    <div class="xcad-tabstrip">
        <div class="xcad-tabstrip-headers" role="tablist">
            @foreach (var tab in visibleTabs)
            {
                var t = tab;
                <button type="button" role="tab"
                        class="xcad-tab-header @(ReferenceEquals(t, activeTab) ? "xcad-tab-header-active" : "")"
                        disabled="@(!t.Enabled)"
                        title="@t.Tooltip"
                        @onclick="() => SelectTab(t)">
                    @t.Header
                </button>
            }
        </div>
        <div class="xcad-tabstrip-body">
            <ControlHostRenderer Controls="activeTab.Controls" />
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BlazorPropertyManagerPageTab> Tabs { get; set; }

    private BlazorPropertyManagerPageTab m_ActiveTab;

    private void SelectTab(BlazorPropertyManagerPageTab tab)
    {
        m_ActiveTab = tab;
    }
}
