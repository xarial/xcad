<UserControl x:Class="Xarial.XCad.Toolkit.Windows.UI.PropertyPage.Toolkit.Templates.PropertyManagerPageControlsHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Xarial.XCad.Toolkit.Windows.UI.PropertyPage.Toolkit.Templates"
             xmlns:pmpenum="clr-namespace:Xarial.XCad.UI.PropertyPage.Enums;assembly=Xarial.XCad"
             xmlns:wpf="clr-namespace:Xarial.XCad.Toolkit.Windows.UI.Wpf"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <wpf:EnumFlagToVisibilityConverter x:Key="enumFlagToVisConv"/>
        <wpf:NotNullOrEmptyToVisibilityConverter x:Key="notNullToVisConv"/>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Path=Controls}">
            <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Path=Label}" Grid.Row="0" Margin="{x:Static local:PropertyManagerPageControlHostPanel.Margin}"
                               Visibility="{Binding Path=Label, Converter={StaticResource notNullToVisConv}}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="12" Height="12" Margin="{x:Static local:PropertyManagerPageControlHostPanel.Margin}" Grid.Column="0" Visibility="{Binding Path=Align, Converter={StaticResource enumFlagToVisConv}, ConverterParameter={x:Static pmpenum:ControlLeftAlign_e.Indent}}"/>
                        <Grid Width="12" Height="12" Margin="{x:Static local:PropertyManagerPageControlHostPanel.Margin}" Grid.Column="0" Visibility="{Binding Path=Align, Converter={StaticResource enumFlagToVisConv}, ConverterParameter={x:Static pmpenum:ControlLeftAlign_e.DoubleIndent}}"/>
                        <Grid Width="12" Height="12" Margin="{x:Static local:PropertyManagerPageControlHostPanel.Margin}" Grid.Column="1" Visibility="{Binding Path=Align, Converter={StaticResource enumFlagToVisConv}, ConverterParameter={x:Static pmpenum:ControlLeftAlign_e.DoubleIndent}}"/>
                        <Image Source="{Binding Path=Icon}" RenderOptions.BitmapScalingMode="Fant" Grid.Column="1" HorizontalAlignment="Center" Margin="{x:Static local:PropertyManagerPageControlHostPanel.Margin}" Width="12" Height="12">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Icon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <ContentPresenter Content="{Binding Path=.}" ContentTemplate="{Binding Path=Template}"
                                          ToolTip="{Binding Path=Tooltip}"
                                          Height="{Binding Path=Height}" Width="{Binding Path=Width}"
                                          IsEnabled="{Binding Path=Enabled}" Margin="{x:Static local:PropertyManagerPageControlHostPanel.Margin}" Grid.Column="2">
                            <ContentPresenter.Style>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Visible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=Height}" Value="{x:Null}">
                                            <Setter Property="Height" Value="Auto"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:PropertyManagerPageControlHostPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
